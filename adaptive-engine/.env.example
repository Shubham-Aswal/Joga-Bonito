# Adaptive Engine Configuration
PORT=8001
LOG_LEVEL=INFO

# Local SQLite (can use sqlite:///./adaptive_engine.db or sqlite:///:memory:)
DATABASE_URL=sqlite:///./adaptive_engine.db

# Groq LLM API Key (required for AI cognitive coach)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=8
GROQ_MAX_RETRIES=1
